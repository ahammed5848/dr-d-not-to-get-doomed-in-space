# Dr D — Astronaut Health Intelligence System
# Environment Configuration Template

# JWT Cryptographic Secret (Minimum 32 characters, generate with: openssl rand -hex 32)
DR_D_SECRET_KEY=your-secure-random-jwt-secret-key-at-least-32-characters

# Database Connection (SQLite for local dev, PostgreSQL for production)
# SQLite: sqlite:///./dr_d.db
# PostgreSQL: postgresql://user:password@hostname:5432/dr_d_db
DR_D_DB_URL=sqlite:///./dr_d.db

# Server Host & Port
DR_D_HOST=0.0.0.0
DR_D_PORT=8000

# Environment Mode: 'development' or 'production'
ENVIRONMENT=development

# Allowed CORS Origins (Comma-separated, no wildcard '*' in production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.onrender.com

# Testing Flag (0 for normal execution with simulation engine, 1 for unit tests)
TESTING=0
